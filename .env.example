NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
DATABASE_URL=postgresql://...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/onboarding
CLERK_WEBHOOK_SECRET=whsec_...

# Surface hostnames — validated in lib/env.ts; client values in lib/env.client.ts.
# Include the port for local dev (*.localhost resolves natively, no /etc/hosts needed).
# On Vercel: set these to your deployment domains (no port needed).
# The app's absolute URL is derived from NEXT_PUBLIC_APP_HOSTNAME
# (http for localhost, https otherwise) — there is no separate APP_URL var.
NEXT_PUBLIC_APP_HOSTNAME=app.localhost:3000     # PWA host (server routing + client links)
ADMIN_HOSTNAME=admin.localhost:3000             # admin host (server routing)
NEXT_PUBLIC_MARKETING_URL=http://localhost:3000 # marketing site (cross-subdomain links)

# Web Push (VAPID) — generate with `bunx web-push generate-vapid-keys`.
# Leave unset to disable OS push (the in-app notification feed still works).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@findingyourikigai.org

# Profile photo uploads — from your UploadThing dashboard.
UPLOADTHING_TOKEN=

# Email (nodemailer) — when unset, emails are logged to console for dev.
# Set all four to enable real sending (e.g. Gmail, Resend SMTP, Mailgun).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Ikigai <hello@findingyourikigai.org>"
SMTP_SECURE=false
