# Copy to .env and fill in. Everything the app reads is listed here — lib/env.ts
# validates the server values at boot and fails with a readable error rather
# than an `undefined` deep inside a request, so a missing REQUIRED value below
# stops the app immediately. Optional values degrade to a documented no-op.

# ---------------------------------------------------------------------------
# Database — REQUIRED
# ---------------------------------------------------------------------------
# Neon Postgres connection string. `bun run db:push` writes to whatever this
# points at, so check it before pushing a schema change.
DATABASE_URL=postgresql://...

# ---------------------------------------------------------------------------
# Auth (Clerk) — REQUIRED
# ---------------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Optional. The Clerk webhook route returns 500 at runtime when unset.
CLERK_WEBHOOK_SECRET=whsec_...

# Read by Clerk itself, not by lib/env.ts.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/onboarding

# ---------------------------------------------------------------------------
# Surface hostnames
# ---------------------------------------------------------------------------
# Validated in lib/env.ts; client values in lib/env.client.ts.
# Include the port for local dev (*.localhost resolves natively, no /etc/hosts).
# On Vercel: set these to your deployment domains (no port needed).
#
# There is no separate APP_URL or ADMIN_URL variable — both absolute URLs are
# derived from the hostnames below (http for localhost, https otherwise).
# env.adminUrl is what admin-facing notifications are linked with, so an
# ADMIN_HOSTNAME that is wrong in production sends admins to a dead link.
NEXT_PUBLIC_APP_HOSTNAME=app.localhost:3000     # PWA host (server routing + client links)
ADMIN_HOSTNAME=admin.localhost:3000             # admin host (server routing)
NEXT_PUBLIC_MARKETING_URL=http://localhost:3000 # marketing site (cross-subdomain links)

# ---------------------------------------------------------------------------
# Web Push (VAPID) — optional
# ---------------------------------------------------------------------------
# Generate a pair with `bunx web-push generate-vapid-keys`.
#
# Leave unset to disable OS push: the in-app notification feed and the whole
# notification system still work, and lib/notifications/transport.ts logs one
# warning saying push is off rather than failing silently.
#
# The two keys are a PAIR and must match the pair the browser subscribed with.
# Generating a fresh pair for local dev while DATABASE_URL points at the shared
# database means every send to an existing subscription is rejected 403 — copy
# the deployed values instead of generating new ones if you want to exercise
# push against real subscriptions.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@findingyourikigai.org

# ---------------------------------------------------------------------------
# Scheduled jobs — required in production
# ---------------------------------------------------------------------------
# Shared secret for the cron endpoints, sent by Vercel Cron as
# `Authorization: Bearer $CRON_SECRET`. Both routes FAIL CLOSED when it is
# unset — they return 503 rather than running unauthenticated, because one of
# them deletes accounts.
#
# Generate with `openssl rand -hex 32`. Must match the value set in Vercel.
# Jobs (see vercel.json):
#   /api/cron/purge-accounts  daily — deletes accounts past their grace period
#   /api/cron/notifications   daily — inactivity nudges and weekly summaries
CRON_SECRET=

# ---------------------------------------------------------------------------
# File uploads (UploadThing) — optional
# ---------------------------------------------------------------------------
# Profile photos and mentor vetting documents. From your UploadThing dashboard.
UPLOADTHING_TOKEN=

# ---------------------------------------------------------------------------
# Email (nodemailer) — optional, but see below
# ---------------------------------------------------------------------------
# When SMTP_HOST, SMTP_USER or SMTP_PASS is unset, lib/email.ts logs the
# recipient and subject to the console and sends nothing. That keeps dev
# booting without credentials — but in PRODUCTION it means guardian invite
# codes, mentor verification decisions and the weekly summaries are written and
# then dropped. Set these on the deployment.
#
# Works with any SMTP provider (Amazon SES, Resend, Postmark, Mailgun, Gmail).
# Verify SPF/DKIM for the SMTP_FROM domain or the mail lands in spam.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Ikigai <hello@findingyourikigai.org>"
SMTP_SECURE=false
