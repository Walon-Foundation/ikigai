# Copy to .env and fill in. src/env.ts validates these at boot and fails with a
# readable error rather than an `undefined` deep inside a request.

# ---------------------------------------------------------------------------
# Database — REQUIRED
# ---------------------------------------------------------------------------
# Local development runs Postgres in Docker: `docker compose up -d`.
#
# Host port is 5433, not 5432 — see docker-compose.yml. Another project on a
# developer machine commonly holds 5432, and the compose file takes
# POSTGRES_PORT to move it again if 5433 is taken too. Keep this URL in step
# with whatever the compose file publishes.
#
# In production this points at Neon. Use the POOLED connection string: the API
# holds a real connection pool (src/db/db.ts), unlike the client, which talks to
# Neon over HTTP.
DATABASE_URL=postgresql://ikigai:ikigai@localhost:5433/ikigai

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
# 4000, not 3000 — the client's Next.js dev server owns 3000.
PORT=4000
NODE_ENV=development

# Shared secret the client presents on internal calls. Transitional —
# removed when Better Auth lands. MUST be a real secret in production; the
# server refuses to boot in production if left at this default.
INTERNAL_API_TOKEN=dev-internal-token
