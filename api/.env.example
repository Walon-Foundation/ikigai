# Copy to .env and fill in. src/env.ts validates these at boot and fails with a
# readable error rather than an `undefined` deep inside a request.

# ---------------------------------------------------------------------------
# Database — REQUIRED
# ---------------------------------------------------------------------------
# Local development runs Postgres in Docker: `docker compose up -d`.
#
# Host port is 5433, not 5432 — see docker-compose.yml. Another project on a
# developer machine commonly holds 5432, and the compose file takes
# POSTGRES_PORT to move it again if 5433 is taken too. Keep this URL in step
# with whatever the compose file publishes.
#
# In production this points at Neon. Use the POOLED connection string: the API
# holds a real connection pool (src/db/db.ts), unlike the client, which talks to
# Neon over HTTP.
DATABASE_URL=postgresql://ikigai:ikigai@localhost:5433/ikigai

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
# 4000, not 3000 — the client's Next.js dev server owns 3000.
PORT=4000
NODE_ENV=development

# Shared secret the client presents on internal calls. Transitional —
# removed when Better Auth lands. MUST be a real secret in production; the
# server refuses to boot in production if left at this default.
INTERNAL_API_TOKEN=dev-internal-token

# ---------------------------------------------------------------------------
# Better Auth — docs/02-auth.md
# ---------------------------------------------------------------------------
# Signing secret. Generate with `openssl rand -base64 32`. The server REFUSES
# to boot in production while this is left at its development value, because a
# guessable secret here forges any session.
BETTER_AUTH_SECRET=dev-only-better-auth-secret-not-for-production-use

# Absolute base URL of THIS server. Must be explicit or OAuth returns
# redirect_uri_mismatch in production.
BETTER_AUTH_URL=http://localhost:4000

# Parent domain the session cookie is set on, so the apex, app.* and admin.*
# share one session. REQUIRED in production — an unset value is the most common
# cause of a cross-subdomain redirect loop, so the server refuses to boot
# without it. Leave unset locally.
AUTH_COOKIE_DOMAIN=

MARKETING_URL=http://localhost:3000

# Google OAuth. Redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
# Unset disables the Google button; email+password still works.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Object storage (Cloudflare R2) — optional
# ---------------------------------------------------------------------------
# Unset disables uploads cleanly: the endpoints return 503 rather than issuing
# URLs that would fail at the storage layer.
#
# R2 buckets are PRIVATE by default and nothing here makes an object public.
# Vetting documents and task evidence are read through short-lived signed URLs;
# only CMS imagery lives in the public bucket.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=ikigai
R2_PUBLIC_BUCKET=ikigai-public

# Custom domain bound to the PUBLIC bucket. The S3 endpoint requires signing
# even for a public bucket, so a URL built from it would expire.
R2_PUBLIC_BASE_URL=https://cdn.findingyourikigai.org
