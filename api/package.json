    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "schema:check": "bun scripts/schema-sync.ts check",
    "schema:sync": "bun scripts/schema-sync.ts sync"
  },
  "dependencies": {
